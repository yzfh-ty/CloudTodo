# 3.44.0 is the newest 3.44.x tag published to ghcr.io/cirruslabs/flutter;
# 3.44.6 exists only as an SDK release, not as a container image.
FROM ghcr.io/cirruslabs/flutter:3.44.0 AS builder

WORKDIR /app

COPY pubspec.yaml pubspec.lock ./
RUN flutter pub get

COPY . .
RUN flutter build web --release --no-web-resources-cdn

FROM nginx:1.27-alpine AS runner

ENV APP_NAME="CloudTodo Web"
ENV APP_ENV=production
ENV API_BASE_URL=

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY docker-entrypoint-config.sh /docker-entrypoint.d/30-config.sh
# The master process runs as the unprivileged nginx user with a read-only
# root filesystem, so the pid file and every temp path must live under the
# /tmp tmpfs (root-owned tmpfs mounts are not writable by uid 101).
RUN chmod +x /docker-entrypoint.d/30-config.sh \
    && sed -i 's|^pid\s.*;$|pid /tmp/nginx.pid;|' /etc/nginx/nginx.conf \
    && printf '%s\n' \
      'client_body_temp_path /tmp/client_temp;' \
      'proxy_temp_path /tmp/proxy_temp;' \
      'fastcgi_temp_path /tmp/fastcgi_temp;' \
      'uwsgi_temp_path /tmp/uwsgi_temp;' \
      'scgi_temp_path /tmp/scgi_temp;' \
      > /etc/nginx/conf.d/00-temp-paths.conf \
    && chown -R nginx:nginx /usr/share/nginx/html /var/log/nginx /etc/nginx/conf.d
COPY --from=builder --chown=nginx:nginx /app/build/web /usr/share/nginx/html

USER nginx

EXPOSE 8080

CMD ["nginx", "-g", "daemon off;"]
