# 默认生产环境模板
# 复制为 .env 后，请按实际部署环境替换域名、数据库连接串和密钥

# 当前运行环境，例如 development / production
NODE_ENV=production
# 后端 HTTP 服务监听端口
PORT=3000
# Compose 发布端口默认只绑定宿主机回环地址，供本机 TLS 终止代理转发
SERVER_BIND_ADDRESS=127.0.0.1
SERVER_PORT=3000
# 服务名称，用于日志或页面展示
APP_NAME=CloudTodo Server
# 当前服务的对外访问基础地址
APP_BASE_URL=https://todo.example.com
# 直接运行服务端时使用的 PostgreSQL 连接串；Compose 会使用下方 POSTGRES_* 构造容器内连接串
DATABASE_URL=postgresql://app_user:REPLACE_WITH_RANDOM_DB_PASSWORD@db.internal.example.com:5432/cloudtodo?schema=public
# 基础 Compose 内置 PostgreSQL 的初始化参数；密码必须由 Secret Manager 替换
POSTGRES_USER=app_user
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_DB_PASSWORD
POSTGRES_DB=cloudtodo
# 用户会话签名密钥
JWT_ACCESS_SECRET=REPLACE_WITH_32_BYTE_RANDOM_SECRET
# 预留给 refresh token 体系的签名密钥
JWT_REFRESH_SECRET=REPLACE_WITH_32_BYTE_RANDOM_SECRET
# Webhook 默认签名密钥
WEBHOOK_SIGNING_SECRET=REPLACE_WITH_32_BYTE_RANDOM_SECRET
# 管理员后台会话签名密钥
ADMIN_SESSION_SECRET=REPLACE_WITH_32_BYTE_RANDOM_SECRET
# CSRF token 签名密钥，生产环境请使用 32 字符以上随机值
CSRF_SECRET=REPLACE_WITH_32_BYTE_RANDOM_SECRET
# Webhook secret 静态加密密钥，生产环境请使用 32 字符以上随机值
WEBHOOK_SECRET_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_RANDOM_SECRET
# 密码重置 token HMAC 密钥，生产环境请使用 32 字符以上随机值
PASSWORD_RESET_TOKEN_SECRET=REPLACE_WITH_32_BYTE_RANDOM_SECRET
# Exact browser origins allowed to send credentialed requests (no wildcard)
CORS_ORIGINS=https://todo.example.com
# Comma-separated reverse proxy addresses, or leave empty when connecting directly
TRUSTED_PROXY_IPS=
# Required in production; do not run the seed command as part of application startup
COOKIE_SECURE=true
# 生产环境禁止运行开发 seed。首次管理员通过 npm run provision:admin 创建，
# ADMIN_INITIAL_*（尤其密码）应仅在执行该一次性命令时临时注入，不写入本文件。
# 是否启用提醒调度器和投递 worker
SCHEDULER_ENABLED=true
# 扫描到期提醒的时间间隔，单位毫秒
SCHEDULER_SCAN_INTERVAL_MS=5000
# 扫描待投递 webhook 任务的时间间隔，单位毫秒
DELIVERY_SCAN_INTERVAL_MS=5000
# 单条 webhook 投递的最大尝试次数
DELIVERY_MAX_ATTEMPTS=3
# processing 投递的崩溃恢复租约，单位毫秒；应明显长于出站请求超时
DELIVERY_PROCESSING_LEASE_MS=60000
# Webhook 出站请求超时，单位毫秒
WEBHOOK_REQUEST_TIMEOUT_MS=5000
# Webhook 响应体读取上限，单位字节
WEBHOOK_RESPONSE_MAX_BYTES=2000
# Maximum webhook request body size in bytes
WEBHOOK_REQUEST_MAX_BYTES=262144
# 每个用户及每个用户-主机可保存的 Webhook 数量
WEBHOOK_MAX_ENDPOINTS_PER_USER=10
WEBHOOK_MAX_ENDPOINTS_PER_HOST_PER_USER=3
# 测试接口按用户、端点、用户-主机和全局主机共同限流
WEBHOOK_TESTS_PER_WINDOW=5
WEBHOOK_TEST_WINDOW_MS=900000
WEBHOOK_GLOBAL_HOST_TESTS_PER_WINDOW=100
# 创建接口按用户、用户-主机和全局主机共同限流
WEBHOOK_CREATES_PER_WINDOW=5
WEBHOOK_CREATE_WINDOW_MS=3600000
WEBHOOK_GLOBAL_HOST_CREATES_PER_WINDOW=100
# 生产默认只允许标准 HTTPS 端口；如需其他公网 TLS 端口，用逗号分隔
WEBHOOK_ALLOWED_PORTS=443
# 出站服务始终拒绝私网目标，生产守卫也要求该值为 false
WEBHOOK_ALLOW_PRIVATE_NETWORKS=false
# Maximum number of in-process fallback rate-limit buckets (use a shared store for multi-instance deployments)
RATE_LIMIT_MAX_BUCKETS=10000
