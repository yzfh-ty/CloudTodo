# Local development defaults. Copy this file to .env for a local server.
NODE_ENV=development
PORT=3000
APP_NAME=CloudTodo Server (Local)
APP_BASE_URL=http://localhost:3000
DATABASE_URL=postgresql://cloudtodo:cloudtodo@localhost:5432/cloudtodo?schema=public
POSTGRES_USER=cloudtodo
POSTGRES_PASSWORD=cloudtodo
POSTGRES_DB=cloudtodo
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5432

# These values are intentionally local-only and must never be reused in production.
JWT_ACCESS_SECRET=local-access-secret
JWT_REFRESH_SECRET=local-refresh-secret
WEBHOOK_SIGNING_SECRET=local-webhook-secret
ADMIN_SESSION_SECRET=local-admin-session-secret
CSRF_SECRET=local-csrf-secret
WEBHOOK_SECRET_ENCRYPTION_KEY=local-webhook-secret-encryption-key
PASSWORD_RESET_TOKEN_SECRET=local-password-reset-token-secret
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
TRUSTED_PROXY_IPS=
COOKIE_SECURE=false

ADMIN_SEED_USERNAME=admin
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=admin123456
ADMIN_SEED_NICKNAME=System Admin
ADMIN_SEED_TIMEZONE=Asia/Shanghai

SCHEDULER_ENABLED=true
SCHEDULER_SCAN_INTERVAL_MS=5000
DELIVERY_SCAN_INTERVAL_MS=5000
DELIVERY_MAX_ATTEMPTS=3
DELIVERY_PROCESSING_LEASE_MS=60000
WEBHOOK_REQUEST_TIMEOUT_MS=5000
WEBHOOK_RESPONSE_MAX_BYTES=2000
WEBHOOK_REQUEST_MAX_BYTES=262144
WEBHOOK_MAX_ENDPOINTS_PER_USER=10
WEBHOOK_MAX_ENDPOINTS_PER_HOST_PER_USER=3
WEBHOOK_TESTS_PER_WINDOW=5
WEBHOOK_TEST_WINDOW_MS=900000
WEBHOOK_GLOBAL_HOST_TESTS_PER_WINDOW=100
WEBHOOK_CREATES_PER_WINDOW=5
WEBHOOK_CREATE_WINDOW_MS=3600000
WEBHOOK_GLOBAL_HOST_CREATES_PER_WINDOW=100
RATE_LIMIT_MAX_BUCKETS=10000
WEBHOOK_ALLOWED_PORTS=80,443
WEBHOOK_ALLOW_PRIVATE_NETWORKS=false
